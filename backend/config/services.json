          "tags": [
            "dev",
            "yetzirah"
          ]
        },
        {
          "path": "../../../llm-memory/logs/http_server.out.log",
          "channel": "stdout",
          "tags": [
            "service-log",
            "llm-memory"
          ]
        }
      ]
