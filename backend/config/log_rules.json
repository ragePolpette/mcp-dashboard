{
  "rule_sets": {
    "default": [
      {
        "contains": "Method Not Allowed",
        "set": {
          "event": "transport.method_not_allowed",
          "level": "INFO"
        },
        "add_tags": [
          "transport",
          "mcp"
        ]
      },
      {
        "contains": "Invalid Origin header",
        "set": {
          "event": "transport.origin_rejected",
          "level": "WARN"
        },
        "add_tags": [
          "transport",
          "security"
        ]
      }
    ],
    "llm-memory": [
      {
        "contains": "\"event\": \"memory.saved\"",
        "set": {
          "event": "memory.saved",
          "level": "INFO"
        },
        "add_tags": [
          "memory",
          "write"
        ]
      },
      {
        "contains": "\"event\": \"memory.retrieved\"",
        "set": {
          "event": "memory.retrieved",
          "level": "INFO"
        },
        "add_tags": [
          "memory",
          "read"
        ]
      },
      {
        "regex": "MISSING_REQUIRED_FIELDS|MISSING_SURPRISE_SIGNAL|MISSING_INFERENCE_SIGNAL|WRITER_MODEL_UNTRUSTED",
        "set": {
          "event": "memory.compliance_reject",
          "level": "WARN"
        },
        "add_tags": [
          "memory",
          "compliance"
        ]
      },
      {
        "contains": "MEMORY_IMPORTANCE_STRICT",
        "set": {
          "event": "memory.strict_mode",
          "level": "INFO"
        },
        "add_tags": [
          "memory",
          "config"
        ]
      },
      {
        "contains": "importance_score",
        "set": {
          "event": "memory.importance_scored",
          "level": "INFO"
        },
        "add_tags": [
          "memory",
          "scoring"
        ]
      }
    ],
    "llm-context": [
      {
        "contains": "\"event\": \"context.retrieved\"",
        "set": {
          "event": "context.retrieved",
          "level": "INFO"
        },
        "add_tags": [
          "llm-context",
          "retrieval"
        ]
      },
      {
        "contains": "Embedder warmup failed",
        "set": {
          "event": "context.embedder_warmup_failed",
          "level": "WARN"
        },
        "add_tags": [
          "llm-context",
          "embedder"
        ]
      }
    ],
    "llm-db-dev-mcp": [
      {
        "contains": "\"event\":\"db.query.executed\"",
        "set": {
          "event": "db.query.executed",
          "level": "INFO"
        },
        "add_tags": [
          "db",
          "query"
        ]
      },
      {
        "contains": "Not Found: Invalid or expired session ID",
        "set": {
          "event": "transport.invalid_session",
          "level": "WARN"
        },
        "add_tags": [
          "mcp",
          "session"
        ]
      }
    ],
    "llm-sql-db-mcp": [
      {
        "contains": "Not Found: Unknown or expired session.",
        "set": {
          "event": "transport.invalid_session",
          "level": "WARN"
        },
        "add_tags": [
          "mcp",
          "session"
        ]
      },
      {
        "contains": "Field identification LLM failed.",
        "set": {
          "event": "sql-gateway.field_identification_failed",
          "level": "WARN"
        },
        "add_tags": [
          "sql-gateway",
          "anonymization"
        ]
      }
    ],
    "llm-bitbucket-mcp": [
      {
        "contains": "\"tool\":\"list_pull_requests\"",
        "add_tags": ["bitbucket", "pr", "read"]
      },
      {
        "contains": "\"tool\":\"get_pull_request\"",
        "add_tags": ["bitbucket", "pr", "read"]
      },
      {
        "contains": "\"tool\":\"add_pull_request_comment\"",
        "add_tags": ["bitbucket", "pr", "write"]
      },
      {
        "contains": "\"tool\":\"create_pull_request\"",
        "add_tags": ["bitbucket", "pr", "write"]
      },
      {
        "contains": "\"tool\":\"approve_pull_request\"",
        "add_tags": ["bitbucket", "pr", "write"]
      },
      {
        "contains": "\"tool\":\"merge_pull_request\"",
        "add_tags": ["bitbucket", "pr", "write", "destructive"]
      },
      {
        "contains": "\"tool\":\"bb_clone\"",
        "add_tags": ["bitbucket", "clone"]
      },
      {
        "contains": "\"tool\":\"bb_api\"",
        "add_tags": ["bitbucket", "api", "generic"]
      },
      {
        "regex": "\"status\":\\s*(?:401|403)",
        "set": { "event": "bb.auth_error", "level": "ERROR" },
        "add_tags": ["bitbucket", "security"]
      },
      {
        "regex": "\"status\":\\s*429",
        "set": { "event": "bb.rate_limited", "level": "WARN" },
        "add_tags": ["bitbucket", "rate-limit"]
      },
      {
        "contains": "Not Found: Invalid or expired session ID",
        "set": { "event": "transport.invalid_session", "level": "WARN" },
        "add_tags": ["mcp", "session"]
      }
    ],
    "llm-jenkins-mcp": [
      {
        "contains": "\"tool\":\"trigger_demo_deploy\"",
        "add_tags": ["jenkins", "deploy"]
      },
      {
        "regex": "\"tool\":\"trigger_demo_deploy\"[^\\n]*\"outcome\":\"ok\"",
        "set": { "event": "jenkins.deploy.triggered", "level": "INFO" },
        "add_tags": ["jenkins", "deploy", "write"]
      },
      {
        "regex": "\"outcome\":\"rejected\"",
        "set": { "event": "jenkins.tool.rejected", "level": "WARN" },
        "add_tags": ["jenkins", "rejected"]
      },
      {
        "regex": "\"outcome\":\"error\"",
        "set": { "event": "jenkins.tool.error", "level": "ERROR" },
        "add_tags": ["jenkins", "error"]
      },
      {
        "regex": "\"tool\":\"trigger_demo_deploy\"[^\\n]*\"outcome\":\"queued\"",
        "set": { "event": "jenkins.deploy.queued", "level": "INFO" },
        "add_tags": ["jenkins", "deploy", "write", "queued"]
      },
      {
        "regex": "\"tool\":\"trigger_demo_deploy\"[^\\n]*\"outcome\":\"confirm_required\"",
        "set": { "event": "jenkins.deploy.confirm_required", "level": "INFO" },
        "add_tags": ["jenkins", "deploy", "confirm"]
      },
      {
        "regex": "\\] \\S+ confirm\\.requested \\{",
        "set": { "event": "jenkins.confirm.requested", "level": "INFO" },
        "add_tags": ["jenkins", "confirm"]
      },
      {
        "regex": "\\] \\S+ confirm\\.used \\{",
        "set": { "event": "jenkins.confirm.used", "level": "INFO" },
        "add_tags": ["jenkins", "confirm", "write"]
      },
      {
        "regex": "\\] \\S+ confirm\\.expired \\{",
        "set": { "event": "jenkins.confirm.expired", "level": "WARN" },
        "add_tags": ["jenkins", "confirm"]
      },
      {
        "regex": "\\] \\S+ confirm\\.invalid \\{",
        "set": { "event": "jenkins.confirm.invalid", "level": "WARN" },
        "add_tags": ["jenkins", "confirm", "security"]
      },
      {
        "regex": "\\] \\S+ admin\\.denied \\{",
        "set": { "event": "jenkins.admin.denied", "level": "WARN" },
        "add_tags": ["jenkins", "admin", "security"]
      },
      {
        "regex": "\\] \\S+ admin\\.destinations \\{[^\\n]*\"outcome\":\"error\"",
        "set": { "event": "jenkins.admin.discovery_failed", "level": "WARN" },
        "add_tags": ["jenkins", "admin"]
      },
      {
        "regex": "\\] \\S+ config\\.warning \\{",
        "set": { "event": "jenkins.config_warning", "level": "WARN" },
        "add_tags": ["jenkins", "startup"]
      },
      {
        "contains": "\"tool\":\"get_demo_status\"",
        "add_tags": ["jenkins", "read"]
      },
      {
        "contains": "\"tool\":\"get_build_status\"",
        "add_tags": ["jenkins", "read"]
      },
      {
        "contains": "\"tool\":\"get_console_tail\"",
        "add_tags": ["jenkins", "read"]
      },
      {
        "regex": "HTTP (401|403)",
        "set": { "event": "jenkins.auth_error", "level": "ERROR" },
        "add_tags": ["jenkins", "security"]
      },
      {
        "contains": "configurazione non valida",
        "set": { "event": "jenkins.config_invalid", "level": "ERROR" },
        "add_tags": ["jenkins", "startup"]
      }
    ],
    "llm-db-prod-mcp": [
      {
        "contains": "\"event\":\"db.query.executed\"",
        "set": {
          "event": "db.query.executed",
          "level": "INFO"
        },
        "add_tags": [
          "db",
          "query"
        ]
      },
      {
        "contains": "Not Found: Invalid or expired session ID",
        "set": {
          "event": "transport.invalid_session",
          "level": "WARN"
        },
        "add_tags": [
          "mcp",
          "session"
        ]
      },
      {
        "contains": "DeprecationWarning",
        "set": {
          "event": "runtime.deprecation",
          "level": "WARN"
        },
        "add_tags": [
          "runtime"
        ]
      }
    ]
  }
}
